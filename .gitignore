# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# IDE
.idea/
.vscode/

# local env files
.env*.local
.env

# API keys — never commit
src/config.js

# typescript
*.tsbuildinfo
# NOTE: do NOT ignore tooling configs (babel/eslint/metro) — they're needed for
# jest + CI on a fresh checkout. Only src/config.js (API keys) is ignored, above.

# generated native folders
/ios
/android
